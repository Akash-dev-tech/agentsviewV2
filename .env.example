# Bucket name only. The TOML source URLs use this value.
R2_BUCKET=your-r2-bucket

# Read-only R2 API token credentials scoped to the bucket.
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# S3 API endpoint from the R2 dashboard, without a bucket path.
AWS_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_REGION=auto

# Optional Worker settings for teammate names, emails, and machine names.
# Uncomment both lines and fill in your values in .env.
# AV_WORKER_URL=https://your-worker.your-subdomain.workers.dev
# AV_ADMIN_SECRET=your-worker-admin-secret

# Use checksums only when the S3 operation requires them.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# Enforce S3-only discovery for the launchers.
AGENTSVIEW_S3_ONLY=1
